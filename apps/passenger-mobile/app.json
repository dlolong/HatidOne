{
  "expo": {
    "name": "HatidOne",
    "slug": "hatidone-passenger",
    "scheme": "hatidone-passenger",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.hatidone.passenger"
    },
    "android": { "package": "ph.hatidone.passenger" },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your location to set the pickup point for your ride."
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
