EXPO_PUBLIC_APP_ENVIRONMENT=development
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional browser-based password recovery; deployed HTTPS required for staging/production.
EXPO_PUBLIC_WEB_URL=http://localhost:3003
# For a physical device use your computer's LAN address, not 127.0.0.1.
# Never put service-role keys or server secrets in EXPO_PUBLIC_* variables.

# Internal release: staging + deployed HTTPS URLs and public key; never localhost.
