{
  "name": "@hatidone/passenger-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --port 8081",
    "android": "expo run:android --port 8081",
    "ios": "expo run:ios --port 8081",
    "web": "expo start --web --port 8081",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "expo install --check",
    "export:web": "expo export --platform web",
    "ios:open": "expo start --dev-client --ios --port 8081",
    "android:open": "expo start --dev-client --android --port 8081",
    "ios:build": "expo run:ios --no-bundler",
    "android:build": "expo run:android --no-bundler",
    "preview:check": "node ../../packages/mobile/scripts/check-preview.cjs",
    "preview:android": "HATIDONE_RELEASE_BUILD=1 expo run:android --variant release --no-bundler",
    "preview:ios": "HATIDONE_RELEASE_BUILD=1 expo run:ios --configuration Release --no-bundler"
  },
  "dependencies": {
    "@hatidone/core": "*",
    "@hatidone/mobile": "*",
    "@hatidone/types": "*",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@supabase/supabase-js": "^2.57.0",
    "expo": "54.0.37",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "expo-font": "14.0.12",
    "expo-dev-client": "~6.0.21",
    "expo-system-ui": "~6.0.9"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "^5.9.2"
  }
}
